# Frontend Environment Configuration
# Note: For local development, do NOT set VITE_API_BASE_URL
# This allows the Vite proxy to handle API requests and avoid CORS issues
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=/api/v1
VITE_APP_TITLE=Tenggeli Desert Monitoring
VITE_MAP_CENTER_LAT=38.5
VITE_MAP_CENTER_LNG=105.0
VITE_MAP_DEFAULT_ZOOM=11
VITE_ENABLE_DEBUG=false
